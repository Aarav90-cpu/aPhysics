load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//tools:aph.bzl", "APH_COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "aphysics",
    srcs = ["src/app.c"],
    hdrs = ["include/app.h"],
    copts = APH_COPTS,
    includes = ["include"],
)

cc_binary(
    name = "app",
    srcs = ["src/main.c"],
    copts = APH_COPTS,
    includes = ["include"],
    deps = [":aphysics"],
)

cc_test(
    name = "app_test",
    srcs = ["src/main.c"],
    copts = APH_COPTS,
    includes = ["include"],
    deps = [":aphysics"],
)
