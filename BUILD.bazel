load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "aphysics",
    srcs = ["src/app.c"],
    hdrs = ["include/app.h"],
    copts = [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    includes = ["include"],
)

cc_binary(
    name = "app",
    srcs = ["src/main.c"],
    copts = [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    includes = ["include"],
    deps = [":aphysics"],
)

cc_test(
    name = "app_test",
    srcs = ["src/main.c"],
    copts = [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    includes = ["include"],
    deps = [":aphysics"],
)
